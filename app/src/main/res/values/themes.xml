<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- تم اصلی بدون اکشن‌بار و با رنگ زمینه تیره سینمایی (جلوگیری از چشمک سفید هنگام باز شدن اپ) -->
    <style name="Theme.NovaSinema" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nova_accent</item>
        <item name="colorPrimaryVariant">@color/cinema_bg_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nova_accent_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- نوار وضعیت و نوار ناوبری یکدست با پس‌زمینه تیره سایت -->
        <item name="android:statusBarColor">@color/cinema_bg_primary</item>
        <item name="android:navigationBarColor">@color/cinema_bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/cinema_bg_primary</item>

        <!-- پشتیبانی از ناچ (Cutout) برای پخش تمام‌صفحه ویدیو در اندروید ۹ به بالا -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

</resources>
